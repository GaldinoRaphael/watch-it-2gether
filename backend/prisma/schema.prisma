// This is your Prisma schema file,
// learn more about it in the docs String

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/database/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id         String   @id @default(uuid())
  externalId String   @unique
  title      String
  year       String
  posterUrl  String?
  provider   String?
  createdAt  DateTime @default(now())

  votes            Vote[]
  groupWatchedMovie GroupWatchedMovie[]
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  passwordHash   String
  createdAt      DateTime      @default(now())
  ownedGroups    Group[]
  votes          Vote[]
  groups         GroupMember[]
  createdInvites GroupInvite[]
}

model Group {
  id        String        @id @default(uuid())
  name      String
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id])
  members   GroupMember[]
  createdAt DateTime      @default(now())
  vote      Vote[]
  invites   GroupInvite[]
  groupWatchedMovie GroupWatchedMovie[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Vote {
  id         String   @id @default(uuid())
  userId     String
  groupId    String
  movieId    String
  commentary String   @default("")
  rating     Float
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, groupId, movieId])
}

model GroupInvite {
  id    String @id @default(uuid())
  token String @unique

  groupId     String
  invitedById String

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  maxUses Int?
  uses    Int  @default(0)

  group     Group @relation(fields: [groupId], references: [id])
  invitedBy User  @relation(fields: [invitedById], references: [id])
}

model GroupWatchedMovie {
  id         String   @id @default(uuid())
  groupId    String
  movieId    String
  includedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([groupId, movieId])
}
